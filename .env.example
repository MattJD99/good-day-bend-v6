# Good Day Bend v9 - Environment Variables
# Copy this to .env and fill in your actual values

# Google Cloud / Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=good-day-bend-v6
GOOGLE_CLOUD_LOCATION=us-central1

# Firebase / Firestore
# (Uses default credentials if running on Cloud Functions)

# GoHighLevel (for email broadcasts)
GHL_API_KEY=your_ghl_jwt_token_here
GHL_LOCATION_ID=your_ghl_location_id

# Optional: Storage Bucket (for image uploads)
STORAGE_BUCKET=good-day-bend-v6.firebasestorage.app

# Admin Email (for approval notifications)
ADMIN_EMAIL=mdesautel@gmail.com
