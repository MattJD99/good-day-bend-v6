rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // EVENTS: Public Read, Admin Write
    match /events/{document} {
      allow read: if true;
      allow write: if false; // Only backend (Admin SDK) bypasses rules
    }
    
    // DAILY UPDATES: Public Read
    match /daily_updates/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    // ARTICLES: Public Read
    match /articles/{document} {
      allow read: if true;
      allow write: if false;
    }

    // FAVORITES: Public Read
    match /favorites/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ARCHIVE COLLECTIONS: Public Read (for admin review page)
    match /articles_archive_v1_2026-01-04/{document} {
      allow read: if true;
      allow write: if true;  // Allow rating updates
    }
    
    match /daily_updates_archive_v1_2026-01-04/{document} {
      allow read: if true;
      allow write: if true;  // Allow rating updates
    }
    
    // REPOST QUEUE: Public Read/Write (for admin)
    match /repost_queue/{document} {
      allow read, write: if true;
    }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
